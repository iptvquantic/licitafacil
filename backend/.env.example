# ============================================
# LicitaFácil API — variáveis de ambiente (Render → Environment)
# Nunca coloque valores reais neste arquivo.
# ============================================
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://licitafacil-one.vercel.app
# Outras origens permitidas no CORS (separadas por vírgula), opcional
ALLOWED_ORIGINS=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET={{JWT_SECRET}}

# Supabase → Connect → Transaction pooler (porta 6543). URL-encode caracteres especiais da senha.
DATABASE_URL={{DATABASE_URL_TRANSACTION_POOLER}}

# Supabase Storage (só para catálogos antigos; os novos não ficam guardados)
SUPABASE_URL={{SUPABASE_URL}}
SUPABASE_SERVICE_KEY={{SUPABASE_SERVICE_KEY}}

# Dono do sistema (painel administrativo). Vários e-mails separados por vírgula.
ADMIN_EMAILS={{SEU_EMAIL}}

# IA (OpenRouter). O modelo gratuito é escolhido sozinho; OPENROUTER_MODEL é opcional.
OPENROUTER_API_KEY={{OPENROUTER_API_KEY}}
OPENROUTER_MODEL=
IA_MAX_BLOCOS=10

# E-mail transacional (opcional): use UM dos dois
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=LicitaFácil <nao-responda@seudominio.com.br>

# Limites
MAX_FILE_SIZE_MB=50
TRIAL_DAYS=15
